FROM docker.io/oven/bun:1.3.14@sha256:d8a4c24744b290bf789d58966a6f2521fc4d8bec36ec02cead6c541147b7d550 AS bun
FROM docker.io/library/node:22.19.0-bookworm-slim@sha256:1162d0dd01d730cb419448cd49dfb63315ad634c369d41a7001c6946405c54ab
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx \
    && apt-get update \
    && apt-get install -y --no-install-recommends git python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir /tmp/candidate \
    && chown node:node /tmp/candidate
USER node
WORKDIR /tmp/candidate
ENTRYPOINT ["sh", "-c", "tar -xf - && node pi/verification/upstream-check.mjs"]
